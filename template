import os
import re

import matplotlib.pyplot as plt
from shapely.geometry import box, Point
from shapely.ops import unary_union
from matplotlib.patches import Polygon


# ==========================
# Ukuran template
# ==========================

WIDTH = 300
HEIGHT = 200

OUTPUT = "output"

os.makedirs(OUTPUT, exist_ok=True)



# ==========================
# Parsing kode
# ==========================

def parse_code(code):

    """
    AR50
        bottom = 50
        top = None

    AR50R30
        bottom = 50
        top = 30
    """

    radius = re.findall(r"R(\d+)", code)

    bottom = None
    top = None


    if len(radius) >= 1:
        bottom = int(radius[0])


    if len(radius) >= 2:
        top = int(radius[1])


    return bottom, top



# ==========================
# Membuat bentuk
# ==========================

def create_shape(code):

    bottom_r, top_r = parse_code(code)


    # 1. Template persegi panjang

    rectangle = box(
        0,
        0,
        WIDTH,
        HEIGHT
    )


    cutters = []


    # ======================
    # Lingkaran bawah
    # ======================

    if bottom_r:

        circle_bottom = (
            Point(0, 0)
            .buffer(
                bottom_r,
                resolution=100
            )
        )

        cutters.append(circle_bottom)



    # ======================
    # Lingkaran atas
    # ======================

    if top_r:

        circle_top = (
            Point(0, HEIGHT)
            .buffer(
                top_r,
                resolution=100
            )
        )

        cutters.append(circle_top)



    # ======================
    # Potong
    # ======================

    if cutters:

        cutting_shape = unary_union(cutters)

        result = rectangle.difference(
            cutting_shape
        )

    else:

        result = rectangle


    return result



# ==========================
# Export gambar
# ==========================

def draw(code):

    shape = create_shape(code)


    fig, ax = plt.subplots(
        figsize=(6,4)
    )


    # ambil koordinat hasil

    x, y = shape.exterior.xy


    ax.fill(
        x,
        y,
        facecolor="white",
        edgecolor="black",
        linewidth=2
    )


    ax.set_xlim(
        -20,
        WIDTH+20
    )

    ax.set_ylim(
        -20,
        HEIGHT+20
    )

    ax.set_aspect("equal")

    ax.axis("off")


    plt.savefig(
        f"{OUTPUT}/{code}.png",
        dpi=300,
        bbox_inches="tight"
    )


    plt.close()



# ==========================
# Daftar kode
# ==========================

codes = [

    "AR50",
    "AR50R30",
    "AR80",
    "AR100R40"

]


for code in codes:

    draw(code)


print("Selesai")
