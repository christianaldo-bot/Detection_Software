import re
import numpy as np
import matplotlib.pyplot as plt


# =====================================================
# Ukuran benda
# =====================================================

WIDTH = 300
HEIGHT = 180


# =====================================================
# Parser
# =====================================================

def parse_code(code):

    code = code.upper()

    radius = re.findall(r'R(\d+)', code)

    if len(radius) == 0:
        return 0, 0

    if len(radius) == 1:
        return int(radius[0]), 0

    return int(radius[0]), int(radius[1])


# =====================================================
# Membuat busur cekung
# =====================================================

def arc_points(cx, cy, r, start_deg, end_deg, n=40):

    angle = np.deg2rad(np.linspace(start_deg, end_deg, n))

    x = cx + r*np.cos(angle)
    y = cy + r*np.sin(angle)

    return list(zip(x, y))


# =====================================================
# Gambar
# =====================================================

def draw_part(code):

    rb, rt = parse_code(code)

    pts = []

    # -------------------------------------------------
    # mulai dari kiri bawah
    # -------------------------------------------------

    if rb > 0:

        pts.append((0, rb))

        pts.extend(
            arc_points(
                rb,
                rb,
                rb,
                180,
                270
            )
        )

    else:
        pts.append((0, 0))

    # bawah
    pts.append((WIDTH, 0))

    # kanan
    pts.append((WIDTH, HEIGHT))

    # atas
    if rt > 0:
        pts.append((rt, HEIGHT))
    else:
        pts.append((0, HEIGHT))

    # -------------------------------------------------
    # notch atas kiri
    # -------------------------------------------------

    if rt > 0:

        pts.extend(
            arc_points(
                rt,
                HEIGHT-rt,
                rt,
                90,
                180
            )
        )

    # kiri
    if rb > 0:
        pts.append((0, rb))
    else:
        pts.append((0,0))

    pts = np.array(pts)

    plt.figure(figsize=(8,5))

    plt.fill(
        pts[:,0],
        pts[:,1],
        facecolor="white",
        edgecolor="black",
        linewidth=2
    )

    plt.gca().set_aspect("equal")

    plt.xlim(-20, WIDTH+20)
    plt.ylim(-20, HEIGHT+20)

    plt.axis("off")

    plt.title(code)

    plt.show()


# =====================================================
# TEST
# =====================================================

draw_part("AR50")

draw_part("AR50R30")

draw_part("AR80")

draw_part("AR100R40")
