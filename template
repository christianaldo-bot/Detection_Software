import os
import re
import matplotlib.pyplot as plt
from matplotlib.path import Path
from matplotlib.patches import PathPatch
import numpy as np

# ==========================
# Ukuran template
# ==========================
WIDTH = 300
HEIGHT = 200

OUTPUT_FOLDER = "output"
os.makedirs(OUTPUT_FOLDER, exist_ok=True)


# ==========================
# Parser kode
# ==========================
def parse_code(code):

    result = {
        "bottom_radius": 0,
        "top_radius": 0
    }

    if code.startswith("A"):

        radius = re.findall(r"R(\d+)", code)

        if len(radius) >= 1:
            result["bottom_radius"] = int(radius[0])

        if len(radius) >= 2:
            result["top_radius"] = int(radius[1])

    return result


# ==========================
# Menggambar bentuk
# ==========================
def draw_shape(info, filename):

    rb = info["bottom_radius"]
    rt = info["top_radius"]

    verts = []
    codes = []

    # mulai dari bawah kiri
    if rb > 0:
        start_x = rb
    else:
        start_x = 0

    verts.append((start_x, 0))
    codes.append(Path.MOVETO)

    # bawah kanan
    verts.append((WIDTH, 0))
    codes.append(Path.LINETO)

    # kanan atas
    verts.append((WIDTH, HEIGHT))
    codes.append(Path.LINETO)

    # kiri atas
    if rt > 0:
        verts.append((0, HEIGHT))
        codes.append(Path.LINETO)

        theta = np.linspace(np.pi/2, 0, 20)

        for t in theta:
            x = rt * np.cos(t)
            y = HEIGHT - rt + rt*np.sin(t)
            verts.append((x, y))
            codes.append(Path.LINETO)

    else:
        verts.append((0, HEIGHT))
        codes.append(Path.LINETO)

    # kiri bawah
    if rb > 0:

        verts.append((0, rb))
        codes.append(Path.LINETO)

        theta = np.linspace(np.pi, 1.5*np.pi, 20)

        for t in theta:
            x = rb + rb*np.cos(t)
            y = rb + rb*np.sin(t)
            verts.append((x, y))
            codes.append(Path.LINETO)

    else:

        verts.append((0,0))
        codes.append(Path.LINETO)

    verts.append((start_x,0))
    codes.append(Path.CLOSEPOLY)

    fig, ax = plt.subplots(figsize=(6,4))

    patch = PathPatch(
        Path(verts, codes),
        facecolor="white",
        edgecolor="black",
        linewidth=2
    )

    ax.add_patch(patch)

    ax.set_xlim(-10, WIDTH+10)
    ax.set_ylim(-10, HEIGHT+10)

    ax.set_aspect("equal")
    ax.axis("off")

    plt.savefig(filename, dpi=200, bbox_inches="tight")
    plt.close()


# ==========================
# Main
# ==========================
codes = [
    "AR50",
    "AR50R30",
    "AR20",
    "AR80R40"
]

for code in codes:

    info = parse_code(code)

    draw_shape(
        info,
        os.path.join(OUTPUT_FOLDER, code + ".png")
    )

print("Selesai.")
