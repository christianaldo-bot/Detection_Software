import re
import numpy as np
import matplotlib.pyplot as plt
from matplotlib.patches import Arc

# ==========================================================
# CONFIG
# ==========================================================

WIDTH = 300      # panjang benda (mm)
HEIGHT = 180     # tinggi benda (mm)

LINEWIDTH = 2

# ==========================================================
# PARSER
# ==========================================================

def parse_code(code):

    code = code.upper()

    if not code.startswith("A"):
        raise ValueError("Kode harus diawali A")

    radius = list(map(int, re.findall(r'R(\d+)', code)))

    if len(radius) == 0:
        bottom_r = 0
        top_r = 0

    elif len(radius) == 1:
        bottom_r = radius[0]
        top_r = 0

    else:
        bottom_r = radius[0]
        top_r = radius[1]

    return bottom_r, top_r


# ==========================================================
# DRAW
# ==========================================================

def draw_part(code):

    rb, rt = parse_code(code)

    fig, ax = plt.subplots(figsize=(10,6))

    # -----------------------------
    # garis bawah
    # -----------------------------
    ax.plot([-WIDTH/2+rb, WIDTH/2-rb],[0,0],'k',lw=LINEWIDTH)

    # kiri
    ax.plot([-WIDTH/2,-WIDTH/2],[rb,HEIGHT-rt],'k',lw=LINEWIDTH)

    # kanan
    ax.plot([WIDTH/2,WIDTH/2],[rb,HEIGHT-rt],'k',lw=LINEWIDTH)

    # atas
    ax.plot([-WIDTH/2+rt,WIDTH/2-rt],[HEIGHT,HEIGHT],'k',lw=LINEWIDTH)

    # =====================================================
    # BOTTOM LEFT
    # =====================================================

    if rb>0:

        arc = Arc(
            (-WIDTH/2+rb,rb),
            2*rb,
            2*rb,
            angle=0,
            theta1=180,
            theta2=270,
            lw=LINEWIDTH
        )

        ax.add_patch(arc)

    else:

        ax.plot([-WIDTH/2,-WIDTH/2],[0,HEIGHT],'k')

    # =====================================================
    # BOTTOM RIGHT
    # =====================================================

    if rb>0:

        arc = Arc(
            (WIDTH/2-rb,rb),
            2*rb,
            2*rb,
            angle=0,
            theta1=270,
            theta2=360,
            lw=LINEWIDTH
        )

        ax.add_patch(arc)

    # =====================================================
    # TOP LEFT
    # =====================================================

    if rt>0:

        arc = Arc(
            (-WIDTH/2+rt,HEIGHT-rt),
            2*rt,
            2*rt,
            angle=0,
            theta1=90,
            theta2=180,
            lw=LINEWIDTH
        )

        ax.add_patch(arc)

    # =====================================================
    # TOP RIGHT
    # =====================================================

    if rt>0:

        arc = Arc(
            (WIDTH/2-rt,HEIGHT-rt),
            2*rt,
            2*rt,
            angle=0,
            theta1=0,
            theta2=90,
            lw=LINEWIDTH
        )

        ax.add_patch(arc)

    # =====================================================
    # DIMENSION
    # =====================================================

    # Panjang
    y = -35

    ax.annotate(
        "",
        xy=(-WIDTH/2,y),
        xytext=(WIDTH/2,y),
        arrowprops=dict(arrowstyle="<->")
    )

    ax.text(
        0,
        y-8,
        f"{WIDTH} mm",
        ha='center'
    )

    # Tinggi
    x = WIDTH/2+35

    ax.annotate(
        "",
        xy=(x,0),
        xytext=(x,HEIGHT),
        arrowprops=dict(arrowstyle="<->")
    )

    ax.text(
        x+8,
        HEIGHT/2,
        f"{HEIGHT} mm",
        rotation=90,
        va='center'
    )

    # Radius bawah
    if rb>0:

        ax.plot(
            [-WIDTH/2+rb,-WIDTH/2+rb+35],
            [rb,rb+35],
            'k--'
        )

        ax.text(
            -WIDTH/2+rb+40,
            rb+40,
            f"R{rb}"
        )

    # Radius atas
    if rt>0:

        ax.plot(
            [-WIDTH/2+rt,-WIDTH/2+rt+35],
            [HEIGHT-rt,HEIGHT-rt-35],
            'k--'
        )

        ax.text(
            -WIDTH/2+rt+40,
            HEIGHT-rt-45,
            f"R{rt}"
        )

    # =====================================================

    ax.set_aspect("equal")

    ax.set_xlim(-220,220)
    ax.set_ylim(-60,220)

    ax.axis("off")

    plt.title(code)

    plt.savefig(code + ".png", dpi=300, bbox_inches="tight")

    plt.show()


# ==========================================================
# EXAMPLE
# ==========================================================

draw_part("AR50")
# draw_part("AR50R30")
