import matplotlib.pyplot as plt
from matplotlib.path import Path
from matplotlib.patches import PathPatch
import numpy as np
import re
import os


# ukuran template
WIDTH = 300
HEIGHT = 200

OUTPUT = "output"
os.makedirs(OUTPUT, exist_ok=True)



def parse_code(code):
    """
    AR50      -> bottom=50 top=0
    AR50R30   -> bottom=50 top=30
    """

    r = re.findall(r"R(\d+)", code)

    bottom = int(r[0]) if len(r) >= 1 else 0
    top = int(r[1]) if len(r) >= 2 else 0

    return bottom, top



def create_shape(bottom_r, top_r):

    points = []
    commands = []


    # mulai dari bawah kiri setelah radius
    points.append((bottom_r, 0))
    commands.append(Path.MOVETO)


    # bawah
    points.append((WIDTH,0))
    commands.append(Path.LINETO)


    # kanan
    points.append((WIDTH,HEIGHT))
    commands.append(Path.LINETO)


    # atas menuju radius atas
    if top_r > 0:

        points.append((top_r,HEIGHT))
        commands.append(Path.LINETO)

        # arc kiri atas (cekung)
        cx = top_r
        cy = HEIGHT-top_r

        for angle in np.linspace(90,180,30):

            x = cx + top_r*np.cos(np.radians(angle))
            y = cy + top_r*np.sin(np.radians(angle))

            points.append((x,y))
            commands.append(Path.LINETO)

    else:

        points.append((0,HEIGHT))
        commands.append(Path.LINETO)



    # turun sisi kiri
    if top_r > 0:
        start_y = HEIGHT-top_r
    else:
        start_y = HEIGHT


    if bottom_r > 0:

        points.append((0,bottom_r))
        commands.append(Path.LINETO)


        # arc kiri bawah (cekung)

        cx = bottom_r
        cy = bottom_r

        for angle in np.linspace(180,270,30):

            x = cx + bottom_r*np.cos(np.radians(angle))
            y = cy + bottom_r*np.sin(np.radians(angle))

            points.append((x,y))
            commands.append(Path.LINETO)


    else:

        points.append((0,0))
        commands.append(Path.LINETO)



    points.append((bottom_r,0))
    commands.append(Path.CLOSEPOLY)


    return Path(points, commands)




def draw(code):

    bottom, top = parse_code(code)

    path = create_shape(
        bottom,
        top
    )


    fig, ax = plt.subplots(
        figsize=(6,4)
    )


    patch = PathPatch(
        path,
        facecolor="white",
        edgecolor="black",
        linewidth=2
    )


    ax.add_patch(patch)


    ax.set_xlim(-20,WIDTH+20)
    ax.set_ylim(-20,HEIGHT+20)

    ax.set_aspect("equal")
    ax.axis("off")


    plt.savefig(
        f"{OUTPUT}/{code}.png",
        dpi=300,
        bbox_inches="tight"
    )

    plt.close()



# contoh banyak kode
codes = [
    "AR50",
    "AR50R30",
    "AR80",
    "AR100R40"
]


for c in codes:
    draw(c)


print("Selesai")
