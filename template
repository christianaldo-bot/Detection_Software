import os
import re
import matplotlib.pyplot as plt
from matplotlib.path import Path
from matplotlib.patches import PathPatch
import numpy as np


# =========================
# Ukuran benda
# =========================

WIDTH = 300
HEIGHT = 200

OUTPUT = "output"

os.makedirs(OUTPUT, exist_ok=True)



# =========================
# Parsing kode
# =========================

def parse_code(code):

    radius = re.findall(r"R(\d+)", code)

    bottom = 0
    top = 0

    if len(radius) >= 1:
        bottom = int(radius[0])

    if len(radius) >= 2:
        top = int(radius[1])

    return bottom, top



# =========================
# Membuat arc seperempat lingkaran
# =========================

def quarter_circle(cx, cy, r, start_deg, end_deg):

    points = []

    angles = np.linspace(
        np.radians(start_deg),
        np.radians(end_deg),
        30
    )

    for a in angles:

        x = cx + r*np.cos(a)
        y = cy + r*np.sin(a)

        points.append((x,y))

    return points



# =========================
# Membuat bentuk
# =========================

def create_shape(bottom_r, top_r):

    vertices = []
    codes = []


    # mulai dari bawah kanan
    vertices.append((WIDTH,0))
    codes.append(Path.MOVETO)


    # menuju kanan atas
    vertices.append((WIDTH,HEIGHT))
    codes.append(Path.LINETO)


    # =====================
    # Radius kiri atas
    # =====================

    if top_r > 0:

        # garis atas menuju titik awal arc
        vertices.append((top_r,HEIGHT))
        codes.append(Path.LINETO)


        # cekungan masuk ke dalam
        arc = quarter_circle(
            top_r,
            HEIGHT-top_r,
            top_r,
            90,
            180
        )

        for p in arc:
            vertices.append(p)
            codes.append(Path.LINETO)

    else:

        vertices.append((0,HEIGHT))
        codes.append(Path.LINETO)



    # =====================
    # Sisi kiri tengah
    # =====================

    if top_r > 0:

        top_end = HEIGHT-top_r

    else:

        top_end = HEIGHT


    if bottom_r > 0:

        bottom_start = bottom_r

    else:

        bottom_start = 0


    vertices.append((0,bottom_start))
    codes.append(Path.LINETO)



    # =====================
    # Radius kiri bawah
    # =====================

    if bottom_r > 0:

        arc = quarter_circle(
            bottom_r,
            bottom_r,
            bottom_r,
            180,
            270
        )


        for p in arc:

            vertices.append(p)
            codes.append(Path.LINETO)


    else:

        vertices.append((0,0))
        codes.append(Path.LINETO)



    # kembali ke awal

    vertices.append((WIDTH,0))
    codes.append(Path.CLOSEPOLY)


    return Path(vertices,codes)



# =========================
# Menggambar
# =========================

def draw(code):

    bottom_r, top_r = parse_code(code)

    path = create_shape(
        bottom_r,
        top_r
    )


    fig, ax = plt.subplots(
        figsize=(6,4)
    )


    patch = PathPatch(
        path,
        facecolor="white",
        edgecolor="black",
        linewidth=2
    )


    ax.add_patch(patch)


    ax.set_xlim(
        -20,
        WIDTH+20
    )

    ax.set_ylim(
        -20,
        HEIGHT+20
    )

    ax.set_aspect("equal")

    ax.axis("off")


    plt.savefig(
        f"{OUTPUT}/{code}.png",
        dpi=300,
        bbox_inches="tight"
    )

    plt.close()



# =========================
# Input kode
# =========================

codes = [
    "AR50",
    "AR50R30",
    "AR80",
    "AR100R40"
]


for code in codes:

    draw(code)


print("Selesai membuat gambar")
